{
    "name": "@graycodeai/decoder",
    "version": "0.0.1",
    "private": true,
    "description": "Bring Decoder into your terminal",
    "license": "MIT",
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "cpu": [
        "arm64",
        "x64"
    ],
    "scripts": {
        "assemble": "node scripts/assemble-platform-packages.js",
        "postinstall": "node bin/postinstall.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=18"
    },
    "optionalDependencies": {
        "@graycodeai/decoder-darwin-arm64": "0.0.1",
        "@graycodeai/decoder-darwin-x64": "0.0.1",
        "@graycodeai/decoder-linux-arm64": "0.0.1",
        "@graycodeai/decoder-linux-x64": "0.0.1",
        "@graycodeai/decoder-win32-arm64": "0.0.1",
        "@graycodeai/decoder-win32-x64": "0.0.1"
    }
}
