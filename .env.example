# reflect daemon environment variables — copy to .env and fill in.
# Only REFLECT_DAEMON_API_KEY is consumed from the environment.
REFLECT_DAEMON_API_KEY=

# The following are NOT read by reflect — setting them has no effect:
#   REFLECT_DAEMON_PORT / REFLECT_DAEMON_HOST — daemon binds 127.0.0.1:4590;
#     override with the --host / --port flags (see `reflect daemon start --help`)
#   RELAY_API_KEY / RELAY_BASE_URL, HARRIER_API_KEY / HARRIER_ADDR —
#     consumed by sibling services, not by this binary
# See docs/user-guide/05-configuration.md for the full precedence chain.
