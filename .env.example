# decoder daemon environment variables — copy to .env and fill in.
# Only DECODER_DAEMON_API_KEY is consumed from the environment.
DECODER_DAEMON_API_KEY=

# The following are NOT read by decoder — setting them has no effect:
#   DECODER_DAEMON_PORT / DECODER_DAEMON_HOST — daemon binds 127.0.0.1:4590;
#     override with the --host / --port flags (see `decoder daemon start --help`)
#   MUX_API_KEY / MUX_BASE_URL, HARRIER_API_KEY / HARRIER_ADDR —
#     consumed by sibling services, not by this binary
# See docs/user-guide/05-configuration.md for the full precedence chain.
